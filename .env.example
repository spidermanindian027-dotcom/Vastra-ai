# ============================================================
# VESTRA AI - Environment Configuration
# "See it. Style it. Own it."
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/vestra_ai?schema=public"

# ── Session / Auth ────────────────────────────────────────────
SESSION_SECRET="generate-a-secure-random-string-at-least-64-chars"
SESSION_MAX_AGE_HOURS=72

# ── Admin Account ─────────────────────────────────────────────
# Used by the seed script to create the single admin account.
# Change these before first deployment.
ADMIN_EMAIL="admin@vestra.ai"
ADMIN_PASSWORD="ChangeThisSecurePassword123!"

# ── AI Provider ───────────────────────────────────────────────
# The AI service abstraction supports multiple providers.
# Set AI_PROVIDER to: openai | google | anthropic | demo
AI_PROVIDER="demo"
AI_API_KEY=""
AI_MODEL="gpt-4o"
AI_VISION_MODEL="gpt-4o"

# For virtual try-on (image generation)
AI_IMAGE_PROVIDER="demo"
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL=""

# ── Object Storage ────────────────────────────────────────────
# S3-compatible object storage for user photos and clothing images.
# Supports AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces, etc.
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="vestra-uploads"
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_URL=""

# ── Maps / Location ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
GEOCODING_PROVIDER="demo"

# ── Weather ───────────────────────────────────────────────────
WEATHER_API_KEY=""
WEATHER_PROVIDER="demo"

# ── App Configuration ────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="VESTRA AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_TAGLINE="See it. Style it. Own it."
NODE_ENV="development"
DEMO_MODE="true"

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ── Upload Limits ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
